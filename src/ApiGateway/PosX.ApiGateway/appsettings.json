{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "ThisIsAVerySecureKeyForJWTTokenGenerationAndValidation123456",
    "Issuer": "PosX.Identity",
    "Audience": "PosX.Clients"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/api/v1/sales/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/v1/inventory/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "customers-route": {
        "ClusterId": "customers-cluster",
        "Match": {
          "Path": "/api/v1/customers/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "employees-route": {
        "ClusterId": "employees-cluster",
        "Match": {
          "Path": "/api/v1/employees/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "reports-route": {
        "ClusterId": "reports-cluster",
        "Match": {
          "Path": "/api/v1/reports/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "dashboard-route": {
        "ClusterId": "reports-cluster",
        "Match": {
          "Path": "/api/v1/dashboard/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "sales-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "customers-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "employees-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "reports-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5107"
          }
        }
      }
    }
  }
}
