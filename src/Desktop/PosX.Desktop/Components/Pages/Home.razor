@page "/"
@attribute [Authorize]

<PageTitle>PosX - Ana Sayfa</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Hoş Geldiniz</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Bugünkü Satış</MudText>
                        <MudText Typo="Typo.h5">0 TL</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" Color="Color.Success" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Bugünkü İşlem</MudText>
                        <MudText Typo="Typo.h5">0</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Size="Size.Large" Color="Color.Primary" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Toplam Ürün</MudText>
                        <MudText Typo="Typo.h5">0</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Info" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="2">
            <MudCardContent>
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Düşük Stok</MudText>
                        <MudText Typo="Typo.h5">0</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Large" Color="Color.Warning" />
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" Class="mb-2">Hızlı Erişim</MudText>
    <div class="d-flex flex-wrap gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/sales" StartIcon="@Icons.Material.Filled.PointOfSale">Yeni Satış</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/products" StartIcon="@Icons.Material.Filled.Add">Ürün Ekle</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/customers" StartIcon="@Icons.Material.Filled.PersonAdd">Müşteri Ekle</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/reports" StartIcon="@Icons.Material.Filled.Assessment">Raporlar</MudButton>
    </div>
</MudPaper>
